@page
@model razorpages.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

<div style="background-image: url('/images/background.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; height: 100vh; display: flex; justify-content: center; align-items: center;">
    <form method="post" style="background-color: rgba(255, 255, 255, 0.9); padding: 20px; border-radius: 8px; width: 300px;">
        <div class="form-group">
            <label>Username</label>
            <input asp-for="Input.Username" class="form-control" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Login</button>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="text-danger mt-2">@Model.ErrorMessage</div>
        }
    </form>
</div>