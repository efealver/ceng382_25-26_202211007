@page
@model razorpages.Pages.IndexModel
@{
    bool isEditing = Model.EditId.HasValue;
}

<h2>Class Information</h2>

<div class="container">
    <div class="row">
        <!-- Left Side: Form -->
        <div class="col-md-4">
            <form method="post">
                <input type="hidden" asp-for="EditId" />

                <div class="mb-3">
                    <label class="form-label">Class Name:</label>
                    <input type="text" asp-for="ClassName" class="form-control" required />
                    <span class="text-danger" asp-validation-for="ClassName"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Student Count:</label>
                    <input type="number" asp-for="StudentCount" class="form-control" required min="1" />
                    <span class="text-danger" asp-validation-for="StudentCount"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description:</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(isEditing ? "Update Class" : "Add Class")
                </button>

                @if (isEditing)
                {
                    <a href="/Index" class="btn btn-secondary">Cancel Edit</a>
                }
            </form>
        </div>

        <!-- Right Side: Table and Controls -->
        <div class="col-md-8">

            <!-- Filter Form -->
            <form method="get" class="mb-3 d-flex gap-2">
                <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by class name..." />
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>

            <!-- Export Buttons -->
            @* <form method="post" class="mb-3">
                <div class="mb-3">
                    <button type="submit" name="exportMode" value="filtered" asp-page-handler="Export" class="btn btn-success me-2">
                        Export Filtered
                    </button>
                    <button type="submit" name="exportMode" value="unfiltered" asp-page-handler="Export" class="btn btn-secondary">
                        Export All
                    </button>
                </div>
            </form> *@

            <!-- Table with Column Toggle Header -->
            <form method="get" id="columnFilterForm">
                <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />

                <table class="table table-striped">
                    <thead>
                        <tr>
                            @foreach (var column in Model.AllColumns)
                            {
                                var isSelected = Model.SelectedColumns.Contains(column);
                                var btnClass = isSelected ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-secondary";
                                <th>
                                    <button name="toggleColumn" value="@column" class="@btnClass" form="columnFilterForm">
                                        @column
                                    </button>
                                </th>
                            }
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var classInfo in Model.TableData)
                        {
                            <tr>
                               
                                @if (Model.SelectedColumns.Contains("ClassName"))
                                {
                                    <td>@classInfo.ClassName</td>
                                }
                                @if (Model.SelectedColumns.Contains("StudentCount"))
                                {
                                    <td>@classInfo.StudentCount</td>
                                }
                                @if (Model.SelectedColumns.Contains("Description"))
                                {
                                    <td>@classInfo.Description</td>
                                }
                                <td>
                                    <a href="?editId=@classInfo.Id&FilterClassName=@Model.FilterClassName&PageNumber=@Model.PageNumber" class="btn btn-warning btn-sm">Edit</a>

                                    <form method="post" asp-page-handler="Delete" style="display:inline;">
                                        <input type="hidden" name="id" value="@classInfo.Id" />
                                        <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <form method="post" asp-page-handler="Export">
                    <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    
                    @foreach (var col in Model.SelectedColumns)
                    {
                        <input type="hidden" name="SelectedColumns" value="@col" />
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" name="exportMode" value="filtered" class="btn btn-success">
                            Export Filtered Data
                        </button>
                        <button type="submit" name="exportMode" value="unfiltered" class="btn btn-info">
                            Export Visible Page
                        </button>
                    </div>
                </form>

            </form>

            <!-- Pagination -->
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?PageNumber=@i&FilterClassName=@Model.FilterClassName">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
